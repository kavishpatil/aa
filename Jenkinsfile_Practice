pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'jdk 25'
    }

    stages {
        stage('Build') {
            steps {
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }

        stage('Post Build') {
            steps {
                echo 'Build and unit tests completed successfully.'
            }
        }
    }
}
